{
  "task": "task",
  "harness": "the bundle's own tests/manifest.json verifier_specs, unmodified, run through the vendored tests/rl_world_verifiers engine (the same code path benchmark_runner.py uses for file_check) against a workspace built from solution/artifact_plan.json",
  "scope": "the 13 core file_check verifiers. database_state, rubric_check and tool_execution verifiers are not workspace artifacts and are not mutable this way.",
  "controls": {
    "positive": "the oracle's own artifacts score every file_check",
    "semantic": "one corrupted graded value fails EXACTLY the verifier that grades it",
    "granularity": "one corrupted value fails exactly one verifier and the rest still pass, so reward drops by that entry's weight rather than to zero",
    "cosmetic": "presentation changes that leave every number correct still score every file_check",
    "incompleteness": "an artifact missing a graded value fails the verifier that grades it, rather than passing on a lenient lookup",
    "adversarial_acceptance": "a plausible WRONG answer -- a superset report, or every figure off by one -- fails rather than scoring"
  },
  "strictness_pct": 100.0,
  "brittleness_pct": 0.0,
  "all_controls_pass": true,
  "superset_report_accepted": false,
  "residual_risk_duplicate_graded_key": {
    "verifiers_that_wrongly_fail": null,
    "note": "a correct answer that also writes a breakdown reusing a graded key name. No clean fix: prompt clause is mitigation only, `contains` breaks the single-match case, `$..key[0]` fails every case. Not counted in brittleness."
  },
